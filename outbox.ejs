<%- include('partials/header', { title: 'Sent Outbox - WBUHS E-File System' }) %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h3 class="fw-bold mb-1"><i class="fa-solid fa-paper-plane text-info me-2"></i> Sent / Forwarded Files</h3>
    <p class="text-muted mb-0">Files created or transferred by you currently being processed by recipient officers.</p>
  </div>
</div>

<div class="card shadow-sm border-0">
  <div class="card-body p-0">
    <% if (files.length === 0) { %>
      <div class="text-center py-5">
        <i class="fa-solid fa-paper-plane fs-1 text-muted mb-3"></i>
        <h5 class="text-secondary">No sent files found</h5>
        <p class="text-muted small">Files forwarded by you will appear here for tracking.</p>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>File Number</th>
              <th>Subject</th>
              <th>Current Holder</th>
              <th>Designation</th>
              <th>Status</th>
              <th>Last Updated</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% files.forEach(file => { %>
              <tr>
                <td class="fw-bold text-primary"><%= file.fileNo %></td>
                <td>
                  <div class="fw-semibold text-dark"><%= file.subject %></div>
                  <small class="text-muted"><i class="fa-solid fa-paperclip"></i> <%= file.attachments ? file.attachments.length : 0 %> attachment(s)</small>
                </td>
                <td>
                  <div class="fw-bold text-dark"><i class="fa-solid fa-user me-1 text-secondary"></i> <%= file.currentHolderName %></div>
                </td>
                <td><span class="badge bg-light text-dark border"><%= file.currentHolderDesignation %></span></td>
                <td>
                  <% if (file.status === 'Approved') { %>
                    <span class="badge bg-success"><i class="fa-solid fa-circle-check me-1"></i> Approved</span>
                  <% } else if (file.status === 'Returned') { %>
                    <span class="badge bg-danger"><i class="fa-solid fa-rotate-left me-1"></i> Returned</span>
                  <% } else { %>
                    <span class="badge bg-info"><i class="fa-solid fa-arrows-spin me-1"></i> Forwarded / Pending</span>
                  <% } %>
                </td>
                <td class="small text-muted"><%= new Date(file.updatedAt || file.createdAt).toLocaleDateString('en-IN') %></td>
                <td class="text-end">
                  <a href="/file/<%= file.id %>" class="btn btn-outline-primary btn-sm me-1">
                    <i class="fa-solid fa-eye me-1"></i> View Details
                  </a>
                  <a href="/file/<%= file.id %>/tracking" class="btn btn-info btn-sm text-white">
                    <i class="fa-solid fa-route me-1"></i> Track Movement
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
