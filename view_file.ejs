<%- include('partials/header', { title: 'File ' + file.fileNo + ' - WBUHS E-File System' }) %>

<!-- File Header Banner -->
<div class="card shadow-sm border-0 mb-4">
  <div class="card-body bg-light py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
      <div>
        <div class="d-flex align-items-center gap-2 mb-1">
          <span class="fs-4 fw-bold text-primary"><i class="fa-solid fa-folder-closed me-2"></i><%= file.fileNo %></span>
          <% if (file.priority === 'Immediate') { %>
            <span class="badge bg-danger"><i class="fa-solid fa-bolt me-1"></i> Immediate</span>
          <% } else if (file.priority === 'Urgent') { %>
            <span class="badge bg-warning text-dark"><i class="fa-solid fa-triangle-exclamation me-1"></i> Urgent</span>
          <% } else { %>
            <span class="badge bg-secondary">Normal</span>
          <% } %>
          <span class="badge bg-dark"><%= file.category %></span>
          <span class="badge bg-outline-info text-dark border"><%= file.confidentiality %></span>
        </div>
        <h5 class="fw-bold text-dark mb-0"><%= file.subject %></h5>
      </div>
      
      <div class="d-flex align-items-center gap-2">
        <a href="/file/<%= file.id %>/noting-pdf" target="_blank" class="btn btn-success fw-bold shadow-sm">
          <i class="fa-solid fa-file-pdf me-1"></i> Download / Print Green Noting PDF
        </a>
        <a href="/file/<%= file.id %>/tracking" class="btn btn-outline-info fw-bold">
          <i class="fa-solid fa-route me-1"></i> Track Movement
        </a>
        <a href="/inbox" class="btn btn-outline-secondary btn-sm">
          <i class="fa-solid fa-arrow-left me-1"></i> Back
        </a>
      </div>
    </div>

    <hr class="my-2 text-muted">

    <div class="row g-2 text-muted small">
      <div class="col-md-3">
        <strong>Initiated By:</strong> <%= file.createdByName %>
      </div>
      <div class="col-md-3">
        <strong>Currently With:</strong> <span class="fw-bold text-dark"><%= file.currentHolderName %> (<%= file.currentHolderDesignation %>)</span>
      </div>
      <div class="col-md-3">
        <strong>Created Date:</strong> <%= new Date(file.createdAt).toLocaleDateString('en-IN') %>
      </div>
      <div class="col-md-3">
        <strong>Current Status:</strong> 
        <% if (file.status === 'Approved') { %>
          <span class="badge bg-success">Approved</span>
        <% } else if (file.status === 'Returned') { %>
          <span class="badge bg-danger">Returned</span>
        <% } else { %>
          <span class="badge bg-warning text-dark">In Process</span>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Split View: Left = Green Sheet Noting, Right = Correspondence & Attachments -->
<div class="file-view-grid">
  
  <!-- Left Side: Green Sheet Noting -->
  <div>
    <div class="green-sheet-container">
      <div class="green-sheet-header">
        <div>
          <h5 class="fw-bold text-success mb-0"><i class="fa-solid fa-book-bookmark me-2"></i> Green Sheet Official Noting</h5>
          <small class="text-success-emphasis">Official University Green Sheet Remarks History</small>
        </div>
        <span class="badge bg-success fs-6"><%= notings.length %> Note(s)</span>
      </div>

      <!-- Notings List -->
      <% if (notings.length === 0) { %>
        <p class="text-muted italic">No green notes recorded yet.</p>
      <% } else { %>
        <% notings.forEach(note => { %>
          <div class="green-note-card">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="green-note-badge">NOTE NO. <%= note.noteNo %></span>
              <small class="text-muted"><i class="fa-regular fa-clock me-1"></i><%= new Date(note.timestamp).toLocaleString('en-IN') %></small>
            </div>
            
            <div class="green-note-content mb-3">
              <%= note.content %>
            </div>

            <div class="officer-signature-box">
              <div class="officer-seal">
                <div class="fw-bold text-dark"><i class="fa-solid fa-signature me-1 text-success"></i> <%= note.authorName %></div>
                <div class="small text-muted"><%= note.authorDesignation %></div>
                <div class="small text-secondary"><%= note.authorDepartment %></div>
                <div class="small text-success fw-bold" style="font-size: 0.75rem;"><i class="fa-solid fa-shield-check me-1"></i> Digital Signature Verified</div>
              </div>
            </div>
          </div>
        <% }) %>
      <% } %>

      <!-- Add Note / Action Form if current holder -->
      <% if (file.currentHolderId === currentUser.id) { %>
        <div class="card mt-4 border-success shadow-sm">
          <div class="card-header bg-success text-white fw-bold">
            <i class="fa-solid fa-file-pen me-2"></i> Add Green Sheet Note & Transfer File
          </div>
          <div class="card-body bg-white">

            <form action="/file/<%= file.id %>/action" method="POST" enctype="multipart/form-data">
              
              <div class="mb-3">
                <label for="newNote" class="form-label fw-bold text-success">Append New Green Sheet Note</label>
                <textarea class="form-control font-monospace" id="newNote" name="newNote" rows="4" placeholder="Type official notation here..."></textarea>
              </div>

              <div class="mb-3">
                <label for="newAttachments" class="form-label fw-semibold">
                  <i class="fa-solid fa-paperclip text-success me-1"></i> Attach Multiple Files (Excel, Word, PDF, Images)
                </label>
                <div class="small text-muted mb-1">Select multiple files at once (`.pdf`, `.xlsx`, `.docx`, `.jpg`, `.png`).</div>
                <input type="file" class="form-control" id="newAttachments" name="newAttachments" multiple accept=".pdf,.docx,.doc,.xlsx,.xls,.png,.jpg,.jpeg">
              </div>

              <hr class="my-3">

              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <label for="recipientId" class="form-label fw-bold">Transfer / Forward To Officer <span class="text-danger">*</span></label>
                  <select class="form-select" id="recipientId" name="recipientId" required>
                    <option value="">-- Select Recipient Officer --</option>
                    <% officers.forEach(officer => { %>
                      <% if (officer.id !== currentUser.id) { %>
                        <option value="<%= officer.id %>">
                          <%= officer.name %> (<%= officer.designation %>, <%= officer.department %>)
                        </option>
                      <% } %>
                    <% }) %>
                  </select>
                </div>

                <div class="col-md-6">
                  <label for="actionType" class="form-label fw-bold">Action Type <span class="text-danger">*</span></label>
                  <select class="form-select" id="actionType" name="actionType" required>
                    <option value="For Approval">For Approval</option>
                    <option value="For Comments / Verification">For Comments / Verification</option>
                    <option value="For Information">For Information</option>
                    <option value="For Signature">For Signature</option>
                    <option value="Approved">Approved & Finalized</option>
                    <option value="Returned">Returned with Queries</option>
                  </select>
                </div>
              </div>

              <div class="mb-3">
                <label for="remarks" class="form-label fw-semibold">Transfer Cover Remarks</label>
                <input type="text" class="form-control" id="remarks" name="remarks" placeholder="Brief note to recipient officer (e.g. Please approve research budget)">
              </div>

              <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-success fw-bold px-4">
                  <i class="fa-solid fa-paper-plane me-1"></i> Save Note & Transfer File
                </button>
              </div>

            </form>

          </div>
        </div>
      <% } else { %>
        <div class="alert alert-info mt-4 mb-0">
          <i class="fa-solid fa-circle-info me-2"></i> This file is currently held by <strong><%= file.currentHolderName %> (<%= file.currentHolderDesignation %>)</strong>. You can view all notes and download attachments.
        </div>
      <% } %>

    </div>
  </div>

  <!-- Right Side: Correspondence & Attachments -->
  <div>
    <div class="correspondence-box">
      <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
        <h5 class="fw-bold text-primary mb-0"><i class="fa-solid fa-paperclip me-2"></i> Correspondence & Attachments</h5>
        <span class="badge bg-primary fs-6"><%= file.attachments ? file.attachments.length : 0 %> File(s)</span>
      </div>

      <!-- Dedicated Quick Attach Multiple Files Box -->
      <% if (file.currentHolderId === currentUser.id) { %>
        <div class="card border-primary mb-3 bg-light">
          <div class="card-body p-3">
            <h6 class="fw-bold text-primary mb-2">
              <i class="fa-solid fa-cloud-arrow-up me-1"></i> Attach Additional Files (Multiple Selection)
            </h6>
            <form action="/file/<%= file.id %>/attach" method="POST" enctype="multipart/form-data" class="row g-2">
              <div class="col-8">
                <input type="file" class="form-control form-control-sm" name="attachments" multiple required accept=".pdf,.docx,.doc,.xlsx,.xls,.png,.jpg,.jpeg">
              </div>
              <div class="col-4">
                <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold">
                  <i class="fa-solid fa-upload me-1"></i> Upload
                </button>
              </div>
              <div class="col-12">
                <small class="text-muted" style="font-size: 0.75rem;">
                  Hold <strong>Ctrl</strong> or <strong>Shift</strong> to select multiple Excel, Word, PDF, or image files at once.
                </small>
              </div>
            </form>
          </div>
        </div>
      <% } %>

      <% if (!file.attachments || file.attachments.length === 0) { %>
        <div class="text-center py-4 text-muted">
          <i class="fa-regular fa-folder-open fs-1 mb-2"></i>
          <p class="mb-0">No attachments uploaded for this file.</p>
        </div>
      <% } else { %>
        <div class="list-group mb-4">
          <% file.attachments.forEach((att, idx) => { %>
            <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3">
              <div class="d-flex align-items-center gap-3">
                <% if (att.originalName.endsWith('.pdf')) { %>
                  <i class="fa-solid fa-file-pdf fs-2 text-danger"></i>
                <% } else if (att.originalName.endsWith('.xlsx') || att.originalName.endsWith('.xls')) { %>
                  <i class="fa-solid fa-file-excel fs-2 text-success"></i>
                <% } else if (att.originalName.endsWith('.docx') || att.originalName.endsWith('.doc')) { %>
                  <i class="fa-solid fa-file-word fs-2 text-primary"></i>
                <% } else if (att.originalName.match(/\.(jpg|jpeg|png)$/i)) { %>
                  <i class="fa-solid fa-file-image fs-2 text-warning"></i>
                <% } else { %>
                  <i class="fa-solid fa-file fs-2 text-secondary"></i>
                <% } %>

                <div>
                  <div class="fw-bold text-dark"><%= att.originalName %></div>
                  <small class="text-muted"><%= att.size || 'Attachment' %> • <%= att.mimeType || 'Document' %></small>
                </div>
              </div>

              <div class="d-flex align-items-center gap-2">
                <a href="<%= att.path %>" target="_blank" class="btn btn-sm btn-outline-primary fw-semibold">
                  <i class="fa-solid fa-eye me-1"></i> Preview
                </a>
                <a href="<%= att.path %>" download="<%= att.originalName %>" class="btn btn-sm btn-success fw-semibold">
                  <i class="fa-solid fa-download me-1"></i> Download
                </a>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>

      <!-- File Movement Quick Summary -->
      <div class="card bg-light border-0">
        <div class="card-header bg-white fw-bold py-2">
          <i class="fa-solid fa-clock-rotate-left me-2 text-secondary"></i> Recent File Movements
        </div>
        <div class="card-body p-2" style="max-height: 250px; overflow-y: auto;">
          <ul class="list-group list-group-flush small">
            <% movements.forEach(mov => { %>
              <li class="list-group-item bg-transparent px-2 py-2">
                <div class="d-flex justify-content-between">
                  <strong class="text-primary"><%= mov.fromUserName %> → <%= mov.toUserName %></strong>
                  <span class="text-muted"><%= new Date(mov.timestamp).toLocaleDateString('en-IN') %></span>
                </div>
                <div class="text-dark">Action: <span class="badge bg-secondary"><%= mov.actionTaken %></span></div>
                <% if (mov.remarks) { %>
                  <div class="text-muted fst-italic">"<%= mov.remarks %>"</div>
                <% } %>
              </li>
            <% }) %>
          </ul>
        </div>
      </div>

    </div>
  </div>

</div>

<%- include('partials/footer') %>
