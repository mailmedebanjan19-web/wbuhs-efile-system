<%- include('partials/header', { title: 'Track Movement ' + file.fileNo + ' - WBUHS E-File System' }) %>

<style>
  @media print {
    .sidebar, .gov-header, .no-print, .btn, footer { display: none !important; }
    .content-area { padding: 0 !important; margin: 0 !important; }
    .card { border: 1px solid #ccc !important; box-shadow: none !important; }
    .print-only-header { display: block !important; text-align: center; margin-bottom: 20px; }
  }
  .print-only-header { display: none; }
</style>

<div class="print-only-header border-bottom pb-3 mb-3">
  <h3 class="fw-bold text-dark">THE WEST BENGAL UNIVERSITY OF HEALTH SCIENCES</h3>
  <h6>DD-36, Sector-1, Salt Lake, Kolkata - 700064</h6>
  <h5 class="fw-bold text-primary mt-2">OFFICIAL FILE MOVEMENT TRACKING REPORT</h5>
</div>

<div class="d-flex justify-content-between align-items-center mb-4 no-print">
  <div>
    <h3 class="fw-bold mb-1"><i class="fa-solid fa-route text-info me-2"></i> File Movement & Lifecycle Tracking</h3>
    <p class="text-muted mb-0">Complete audit timeline for File No: <strong class="text-primary"><%= file.fileNo %></strong></p>
  </div>
  <div class="d-flex gap-2">
    <button onclick="window.print()" class="btn btn-success fw-bold shadow-sm">
      <i class="fa-solid fa-print me-1"></i> Print / Save Movement History PDF
    </button>
    <a href="/file/<%= file.id %>" class="btn btn-primary btn-sm">
      <i class="fa-solid fa-folder-open me-1"></i> Open File
    </a>
    <a href="/inbox" class="btn btn-outline-secondary btn-sm">
      <i class="fa-solid fa-arrow-left me-1"></i> Back
    </a>
  </div>
</div>

<div class="card shadow-sm border-0 mb-4">
  <div class="card-body bg-light py-3">
    <h5 class="fw-bold mb-1 text-dark"><%= file.subject %></h5>
    <div class="small text-muted">
      File No: <strong class="text-primary"><%= file.fileNo %></strong> • Initiated by: <strong><%= file.createdByName %></strong> on <%= new Date(file.createdAt).toLocaleDateString('en-IN') %> • Current Location: <strong class="text-dark"><%= file.currentHolderName %> (<%= file.currentHolderDesignation %>)</strong>
    </div>
  </div>
</div>

<div class="card shadow-sm border-0">
  <div class="card-header bg-white py-3 fw-bold text-dark d-flex justify-content-between align-items-center">
    <span><i class="fa-solid fa-clock-rotate-left text-info me-2"></i> Movement History Audit Trail</span>
    <span class="badge bg-info"><%= movements.length %> Movement(s) Logged</span>
  </div>
  <div class="card-body p-4">

    <div class="tracking-timeline">
      <% movements.forEach((mov, idx) => { %>
        <div class="timeline-item">
          <div class="timeline-icon">
            <%= idx + 1 %>
          </div>
          <div class="timeline-content">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <span class="badge bg-primary fs-6"><%= mov.actionTaken %></span>
              <small class="text-muted"><i class="fa-regular fa-clock me-1"></i><%= new Date(mov.timestamp).toLocaleString('en-IN') %></small>
            </div>

            <div class="row g-2 my-2 align-items-center bg-light p-2 rounded">
              <div class="col-md-5">
                <small class="text-muted d-block">FORWARDED FROM:</small>
                <strong class="text-dark"><i class="fa-solid fa-user-minus text-secondary me-1"></i><%= mov.fromUserName %></strong>
                <div class="small text-muted"><%= mov.fromUserDesignation %></div>
              </div>
              <div class="col-md-2 text-center fs-4 text-primary">
                <i class="fa-solid fa-right-long"></i>
              </div>
              <div class="col-md-5">
                <small class="text-muted d-block">TRANSFERRED TO:</small>
                <strong class="text-success"><i class="fa-solid fa-user-plus text-success me-1"></i><%= mov.toUserName %></strong>
                <div class="small text-muted"><%= mov.toUserDesignation %></div>
              </div>
            </div>

            <% if (mov.remarks) { %>
              <div class="p-2 border-start border-info bg-white text-dark small mt-2">
                <strong>Officer Remarks:</strong> "<%= mov.remarks %>"
              </div>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>

  </div>
</div>

<%- include('partials/footer') %>
